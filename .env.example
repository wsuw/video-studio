AGENT_URL=http://localhost:8123

POSTGRES_URI=postgresql://postgres:password@localhost:5432/video_agent

LLM_PROVIDER=openrouter

OLLAMA_MODEL=gemma4:26b

# DeepSeek Configuration (Optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# OpenRouter Configuration for High-End AI Image & Video Generation
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_LLM_MODEL=openai/gpt-oss-120b:free
OPENROUTER_IMAGE_MODEL=x-ai/grok-imagine-image-quality
OPENROUTER_VIDEO_MODEL=luma/ray-v2

# Storage Settings (local or S3 compatible e.g. MinIO)
STORAGE_BACKEND=local
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_PUBLIC_URL=http://localhost:9000
STORAGE_S3_ACCESS_KEY=your_s3_access_key_here
STORAGE_S3_SECRET_KEY=your_s3_secret_key_here
STORAGE_S3_BUCKET=video-studio

# Local Model Servers URL Configuration
FLUX_SERVER_URL=http://localhost:8124/generate
LTX_SERVER_URL=http://localhost:8125/generate
INDEX_TTS_API_URL=http://localhost:8000/synthesize

    "@copilotkit/react-ui": "1.56.5",
    "@copilotkit/runtime": "1.56.5",
    "@copilotkit/shared": "1.56.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
